    {
      "id": "node-2cfb0733-2cd4-4d4d-a5de-2a9b5c17cf9b",
      "type": "scene",
      "title": "石与灰的当下，节拍4",
      "body": "以某个感官细节（如玻璃震动）为跳板，准备向下一层记忆过渡。",
      "position": {
        "x": 4801.631865480013,
        "y": -815.1791792056785
      },
      "size": {
        "width": 351.7434764740135,
        "height": 220.26313871957285
      },
      "metadata": {
        "createdAt": "2026-06-09T14:19:49.877Z",
        "updatedAt": "2026-06-09T14:20:07.365Z",
        "sourceNodeIds": [],
        "generatedByWorkflow": null,
