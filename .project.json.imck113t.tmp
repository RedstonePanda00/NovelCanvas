    {
      "id": "node-e1314fc2-0ed1-4187-8f7f-c91dbd8b8621",
      "type": "scene",
      "title": "土与根的沉寂节拍3",
      "body": "突然插入铁锹撞击棺材的暴力撕裂感，从土中到光中的剧烈转换。",
      "position": {
        "x": 4819.312019710937,
